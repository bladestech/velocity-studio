{
  "name": "recscreen",
  "version": "1.1.0",
  "description": "RecScreen - an OBS-style screen recorder",
  "main": "main.js",
  "author": "Cole",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "build": {
    "appId": "com.recscreen.app",
    "productName": "RecScreen",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/icon.png"
    }
  }
}
